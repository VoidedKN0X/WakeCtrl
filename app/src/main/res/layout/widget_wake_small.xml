<?xml version="1.0" encoding="utf-8"?>
<!-- The one-cell widget: a smaller icon so the state, the time left and the reason fit. Same views as widget_wake.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_off" />
    <TextView
        android:id="@+id/widget_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/tile_off"
        android:textAllCaps="true"
        android:textColor="#FFF4F4F2"
        android:textSize="10sp" />
    <TextView
        android:id="@+id/widget_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FF9C9CA6"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>

    <!-- Shell texts for this app -->
    <string name="settings_subtitle">Screen, safety, reliability and privacy</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening WakeCtrl. Keeping the screen on carries on while it\'s locked.</string>
    <string name="app_lock_footer">WakeCtrl works fully offline: it has no internet permission, analytics or tracking. Your settings and activity log stay on this phone.</string>
    <string name="lock_prompt_subtitle">Your screen settings</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. WakeCtrl will reset its settings and automations, clear the activity log and turn the app lock off.</string>

    <!-- Tabs -->
    <string name="tab_wake">Wake</string>
    <string name="tab_automations">Automations</string>


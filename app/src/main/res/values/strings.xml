    <!-- Automations -->
    <string name="app_wake">AppWake</string>
    <string name="app_wake_switch">While using selected apps</string>
    <string name="app_wake_sub">Reading, recipes, maps, presentations…</string>
    <string name="app_wake_footer">WakeCtrl checks which app is on screen with Android\'s Usage access. It only reads the app name, on this phone, and only while the screen is on.</string>
    <string name="choose_apps">Choose apps</string>
    <string name="apps_selected_charging">%1$s · %2$d only while charging</string>
    <string name="app_wake_charging_only">Only while charging</string>
    <string name="app_wake_charging_only_sub">Keeps the screen on for this app only when the phone is also charging</string>
    <string name="app_picker_note">Switch on the apps that keep the screen on. For each one you can choose \"Only while charging\", for example for a navigation app that you only want on in the car.</string>
    <string name="search_apps">Search apps</string>
    <string name="loading_apps">Loading apps…</string>
    <string name="charge_wake">ChargeWake</string>
    <string name="charge_wake_switch">While the phone is charging</string>
    <string name="charge_wake_footer">Handy on a dock, a car mount or a nightstand.</string>
    <string name="bt_wake">BTWake</string>
    <string name="bt_wake_switch">While a chosen Bluetooth device is connected</string>
    <string name="bt_wake_footer">For example your car or a speaker. Needs the Nearby devices permission; WakeCtrl only looks at devices you\'ve already paired.</string>
    <string name="choose_devices">Choose devices</string>
    <string name="no_devices">No paired devices</string>
    <string name="no_devices_body">Devices you pair in Android\'s Bluetooth settings show up here.</string>
    <string name="open_bt_settings">Open Bluetooth settings</string>
    <string name="dev_wake">DevWake</string>
    <string name="dev_wake_switch">While a debug build is on screen</string>
    <string name="dev_wake_footer">Keeps the screen on while you test apps you\'re developing (any app marked debuggable). Uses Usage access, like AppWake.</string>
    <string name="schedule_wake">ScheduleWake</string>
    <string name="schedule_wake_switch">During set hours</string>
    <string name="schedule_wake_sub">Keep the screen on in the time windows below</string>
    <string name="schedule_wake_footer">A window that ends at or before its start time runs past midnight and ends the next day; the days are the days it starts. Times follow your phone\'s clock, also after a time zone or daylight-saving change.</string>
    <string name="schedule_add">Add time window</string>
    <string name="schedule_none">No time windows yet</string>
    <string name="schedule_window">%1$s–%2$s</string>
    <string name="schedule_next_day">%1$s · ends the next day</string>
    <string name="schedule_whole_day">%1$s · all day</string>
    <string name="schedule_days_every">Every day</string>
    <string name="schedule_days_weekdays">Weekdays</string>
    <string name="schedule_days_weekend">Weekends</string>
    <string name="schedule_days_none">No days chosen</string>
    <string name="schedule_exact">Allow alarms and reminders</string>
    <string name="schedule_exact_sub">So set hours start and end on the minute. Without it, Android may run them a few minutes late.</string>
    <string name="schedule_edit_title">Time window</string>
    <string name="schedule_new_title">New time window</string>
    <string name="schedule_start">Starts</string>
    <string name="schedule_end">Ends</string>
    <string name="schedule_days">Days</string>
    <string name="schedule_edit_note">Pick the days the window starts on. An end at or before the start means the next day.</string>
    <string name="schedule_delete">Delete time window</string>
    <string name="schedule_delete_body">The screen won\'t be kept on during these hours any more.</string>
    <string name="schedule_delete_confirm">Delete</string>
    <string name="schedule_ok">OK</string>
    <string name="allow_usage">Allow Usage access</string>
    <string name="allow_usage_sub">Needed to see which app is on screen. Find WakeCtrl in the list and switch it on.</string>
    <string name="allow_notifications">Allow notifications</string>
    <string name="allow_notifications_sub">Optional: shows when WakeCtrl holds the screen, with a quick on/off button</string>


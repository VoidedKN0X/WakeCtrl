    <string name="turn_off">Let it sleep</string>
    <string name="group_timer">Timer</string>
    <string name="timer">Keep on for</string>
    <string name="timer_footer">Applies when you turn it on yourself (here, the tile, widget or shortcut). Automations keep the screen on for as long as they match.</string>
    <string name="timer_none">No limit</string>
    <string name="timer_5">5 minutes</string>

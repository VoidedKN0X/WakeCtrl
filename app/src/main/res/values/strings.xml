    <string name="timer_30">30 minutes</string>
    <string name="timer_60">1 hour</string>
    <string name="timer_120">2 hours</string>
    <string name="warn_battery">Tap to set battery use to Unrestricted, so Android doesn\'t stop WakeCtrl in the background.</string>
